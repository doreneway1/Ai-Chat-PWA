#!/bin/sh
### BEGIN INIT INFO
# Provides:          tailscaled
# Required-Start:    $network $local_fs $remote_fs
# Required-Stop:     $network $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Tailscale daemon
# Description:       Tailscale daemon (tailscaled) untuk antiX/sysvinit.
#                    Paket resmi Tailscale hanya membawa unit systemd,
#                    jadi di antiX (tanpa systemd) daemon tidak jalan
#                    otomatis — script ini yang menyalakannya tiap boot.
### END INIT INFO

DAEMON=$(command -v tailscaled)
PIDFILE=/var/run/tailscaled.pid
LOGFILE=/var/log/tailscaled.log

[ -x "$DAEMON" ] || exit 0

case "$1" in
  start)
    echo -n "Starting Tailscale daemon: "
    modprobe tun 2>/dev/null
    mkdir -p /var/run/tailscale /var/lib/tailscale
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$PIDFILE" --exec "$DAEMON" -- --state=/var/lib/tailscale/tailscaled.state --socket=/var/run/tailscale/tailscaled.sock >> "$LOGFILE" 2>&1
    echo "tailscaled."
    ;;
  stop)
    echo -n "Stopping Tailscale daemon: "
    start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --exec "$DAEMON"
    echo "tailscaled."
    ;;
  restart|force-reload)
    $0 stop
    sleep 1
    $0 start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "tailscaled is running (pid $(cat "$PIDFILE"))."
      exit 0
    else
      echo "tailscaled is not running."
      exit 3
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
    exit 3
    ;;
esac
exit 0
