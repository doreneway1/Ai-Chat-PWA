#!/bin/bash
# bersih — perintah pembersih disk untuk antiX live (flashdisk).
# Membersihkan yang aman saja: cache paket apt, cache user,
# tempat sampah, lalu membuang page cache dari RAM.
# Dipanggil Conky ("ketik bersih di terminal untuk cleaning disk").
echo "== bersih: membersihkan =="
sudo apt clean 2>/dev/null && echo "cache apt dibersihkan"
rm -rf ~/.cache/* 2>/dev/null && echo "cache user dibersihkan"
rm -rf ~/.local/share/Trash/* 2>/dev/null && echo "sampah dikosongkan"
sync
echo 1 | sudo tee /proc/sys/vm/drop_caches >/dev/null && echo "page cache dibuang"
echo ""
df -h / /home
